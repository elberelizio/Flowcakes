# Copiar para infra/backend.env na VPS (não commitar) e preencher.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# Ligação ao container "db" do mesmo docker-compose (nome do serviço = hostname)
DB_HOST=db
DB_PORT=5432
DB_NAME=chefcontrol2025
DB_USER=chefcontrol
DB_PASSWORD=TROCAR_PARA_SENHA_FORTE
DATABASE_JDBC_URL=jdbc:postgresql://db:5432/chefcontrol2025

APP_CORS_ALLOWED_ORIGINS=https://flowcakes.vercel.app,https://bolo-gest.vercel.app,http://localhost:4200

# Twilio (SMS/WhatsApp) — copiar valores actuais do Railway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
