# Novo projecto Supabase — preencher após criar o projecto
# Copiar para: backend/supabase.new.env (não commitar)
#
# Dashboard Supabase → Project Settings → Database:
#   - Host (direct): db.<PROJECT_REF>.supabase.co
#   - Host (pooler IPv4, recomendado para Railway/dev): aws-0-<região>.pooler.supabase.com
#   - User pooler: postgres.<PROJECT_REF>
#   - Database: postgres
#   - Password: a que definiu ao criar o projecto

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF_AQUI
DB_PASSWORD=SUA_SENHA_AQUI
DB_SSLMODE=require

DATABASE_JDBC_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

APP_CORS_ALLOWED_ORIGINS=https://flowcakes.vercel.app,https://bolo-gest.vercel.app,http://localhost:4200
